# Server
PORT=4000
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_DAYS=30

# Database (Neon Postgres) — use the pooled connection string, sslmode=require
DATABASE_URL=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Shopify
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,write_products,read_orders,read_customers,write_content

# BigCommerce — get these from the BigCommerce Developer Portal (devtools.bigcommerce.com)
# after creating a draft app (Auth/Load/Uninstall callback URLs point to
# /api/connectors/bigcommerce/{callback,load,uninstall}). To install the draft
# app, sign in to the target store and go to Apps > Develop — no install URL
# to configure here.
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=

# Wix — get App ID/Secret from the Wix Developers Center (dev.wix.com) after
# creating an app (View ID & keys, or the app's OAuth page). The
# postInstallationUrl is built automatically from BACKEND_URL. WIX_SHARE_URL_ID
# is only needed while the app is unlisted (not yet approved on the App
# Market) — get it from the app dashboard's "Share Install Link", drop it
# once the app is listed. BACKEND_URL must be a real HTTPS URL for Wix's
# callback to work (use a tunnel like ngrok for local testing).
WIX_APP_ID=
WIX_APP_SECRET=
WIX_SHARE_URL_ID=

# Google Search Console — create an OAuth 2.0 Client ID (type "Web
# application") at console.cloud.google.com/apis/credentials, enable the
# "Search Console API", and add /api/connectors/google-search-console/callback
# as an authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Autonomous agent — local-dev-only scheduler (see agent.scheduler.js).
# Leave disabled until real hosting is chosen; use POST /api/agent/run or the
# run_autonomous_agent_now chat tool to trigger a run manually until then.
AGENT_CRON_ENABLED=false
AGENT_CRON_SCHEDULE=0 6 * * 0

# SMTP — used to send the email verification code (OTP) at signup and the
# weekly reports. Leave blank in dev: emails are skipped with a console
# warning instead of failing the request.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
